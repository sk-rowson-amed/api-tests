    {
      "name": "Create Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code 200\", () => {\r\n  pm.response.to.have.status(200);\r\n});\r\n\r\nconst body = pm.response.json();\r\n\r\npm.test(\"bookingid এসেছে\", () => {\r\n  pm.expect(body.bookingid).to.be.a(\"number\");\r\n  pm.environment.set(\"bookingId\", body.bookingid);\r\n});\r\n\r\npm.test(\"ডেটা ঠিক আছে\", () => {\r\n  pm.expect(body.booking.firstname).to.eql(\"Rahul\");\r\n  pm.expect(body.booking.lastname).to.eql(\"Das\");\r\n  pm.expect(body.booking.totalprice).to.eql(500);\r\n  pm.expect(body.booking.bookingdates.checkin).to.eql(\"2026-12-01\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"firstname\": \"Rahul\",\r\n  \"lastname\": \"Das\",\r\n  \"totalprice\": 500,\r\n  \"depositpaid\": true,\r\n  \"bookingdates\": {\r\n    \"checkin\": \"2026-12-01\",\r\n    \"checkout\": \"2026-12-05\"\r\n  },\r\n  \"additionalneeds\": \"Breakfast\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/booking",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking"
          ]
        }
      },
      "response": []
